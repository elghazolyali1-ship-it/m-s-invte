# Copy this file to .env for local development.
# On Vercel, set these under Project Settings -> Environment Variables instead
# (never commit the real .env file).

# Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.jqgt8m0.mongodb.net/wedding?appName=Cluster0

# Database name (optional, defaults to "wedding")
MONGODB_DB=wedding

# A secret you make up yourself, used to protect the admin endpoints
# (adding/listing/deleting guests). Put the same value in admin.html when asked.
ADMIN_KEY=change-me-to-something-long-and-random
